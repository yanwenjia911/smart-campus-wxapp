/* pages/profile/index.wxss */
page { background: #f0f2f5; }

.profile-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 48rpx 36rpx 52rpx;
  background: linear-gradient(135deg, #1a7a3c 0%, #1aad19 100%);
  margin-bottom: 0;
}

.avatar-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  border: 4rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.user-role-badge {
  display: inline-flex;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.role-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

/* ===== Section 卡片 ===== */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 0 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 24rpx 32rpx 8rpx;
}

/* ===== 菜单项 ===== */
.menu-list { padding: 0 0 8rpx; }

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.15s;
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #f9f9f9; }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.green  { background: #e8f8e8; }
.blue   { background: #e8f0ff; }
.orange { background: #fff5e6; }
.purple { background: #f3ecff; }
.red    { background: #fff0f0; }
.gray   { background: #f5f5f5; }

.menu-icon { font-size: 36rpx; }

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

.logout-label { color: #ff4d4f; }

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* ===== 版本号 ===== */
.app-version {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 40rpx 0 20rpx;
}
