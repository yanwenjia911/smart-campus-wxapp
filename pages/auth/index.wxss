/* pages/auth/index.wxss */
page {
  background: linear-gradient(135deg, #1a7a3c 0%, #0d5a2b 50%, #0a4020 100%);
  min-height: 100vh;
}

.auth-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
}

/* 顶部 Logo */
.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  backdrop-filter: blur(10px);
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* 登录卡片 */
.auth-card {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
}

.card-title {
  margin-bottom: 40rpx;
}

.title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

/* 输入框 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.auth-input {
  width: 100%;
  height: 90rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.auth-input:focus {
  border-color: #1aad19;
}

/* 绑定按钮 */
.btn-bind {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1aad19, #0d8c0d);
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(26,173,25,0.4);
}

.bind-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 微信登录按钮 */
.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.4);
}

.wechat-icon {
  font-size: 40rpx;
}

.login-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 底部 */
.auth-footer {
  margin-top: 48rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
