/* pages/course/detail.wxss */
/* 全局容器背景 */
.detail-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 50rpx;
}

/* --- 顶部 Hero 区域：解决背景无法渲染的关键 --- */
.course-hero {
  position: relative;
  height: 400rpx;
  /* 使用 CSS 渐变代替图片背景，确保 100% 渲染成功 */
  background: linear-gradient(135deg, #07c160 0%, #10aeff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0 40rpx;
  text-align: center;
}

/* 装饰背景（让背景不单调） */
.course-hero::after {
  content: "";
  position: absolute;
  bottom: -50rpx;
  width: 120%;
  height: 100rpx;
  background: #f8f9fa;
  border-radius: 50%; /* 弧形底边 */
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.hero-name {
  font-size: 44rpx;
  font-weight: bold;
  z-index: 1;
}

.hero-type-badge {
  margin-top: 20rpx;
  padding: 6rpx 24rpx;
  font-size: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  z-index: 1;
}

/* --- 信息卡片通用样式 --- */
.info-card, .time-card {
  position: relative;
  margin: -40rpx 30rpx 30rpx 30rpx; /* 向上偏移压住 Hero */
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.time-card {
  margin-top: 0rpx; /* 第二个卡片不需要负边距 */
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #07c160;
  line-height: 1;
}

/* --- 信息行布局 --- */
.info-row {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon-wrap {
  width: 70rpx;
  height: 70rpx;
  background: #f0fdf4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
}

.info-icon {
  font-size: 36rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* --- 时间点样式 --- */
.time-slot {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-dot {
  width: 12rpx;
  height: 12rpx;
  background: #07c160;
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 0 10rpx rgba(7, 193, 96, 0.4);
}

.time-text {
  font-size: 28rpx;
  color: #666;
}