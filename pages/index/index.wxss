/* pages/index/index.wxss */
page {
  background: #f0f2f5;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.index-container {
  padding-bottom: 30rpx;
}

/* 顶部欢迎栏 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #1a7a3c 0%, #1aad19 100%);
}

.welcome-info {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}

.date-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
}

.header-avatar {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 48rpx;
}

/* 置顶通知 Banner */
.notice-banner {
  margin: 24rpx 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.notice-swiper {
  height: 96rpx;
}

.banner-item {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #fff9e6, #fffdf0);
  border-left: 8rpx solid #ff9500;
}

.banner-tag {
  font-size: 24rpx;
  color: #ff9500;
  font-weight: 600;
  margin-right: 16rpx;
  white-space: nowrap;
}

.banner-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 快捷功能 */
.section-title {
  padding: 32rpx 40rpx 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 8rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.bg-blue { background: linear-gradient(135deg, #e8f4fd, #b3d9f7); }
.bg-orange { background: linear-gradient(135deg, #fef3e2, #fdd28a); }
.bg-green { background: linear-gradient(135deg, #e6f7e9, #a8e6ae); }
.bg-red { background: linear-gradient(135deg, #fde8e8, #f7a8a8); }

.quick-label {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

/* 最新通知 section */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 20rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.section-more {
  font-size: 26rpx;
  color: #1aad19;
}

/* 通知列表 */
.notice-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notice-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: transform 0.15s;
  gap: 20rpx;
}

.notice-card:active {
  transform: scale(0.98);
}

.notice-left {
  flex-shrink: 0;
}

.notice-type-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-blue { background: #e8f4fd; color: #1677ff; }
.tag-orange { background: #fff7e6; color: #ff9500; }
.tag-gray { background: #f5f5f5; color: #666; }

.notice-content {
  flex: 1;
  overflow: hidden;
}

.notice-title {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.notice-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.notice-publisher, .notice-view {
  font-size: 22rpx;
  color: #999;
}

.notice-dot {
  font-size: 22rpx;
  color: #ccc;
}

.notice-arrow {
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1aad19;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 空状态 */
.empty-notice {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}
