<view class="notice-container">
  
  <!-- 1. 顶部切换 Tab -->
  <view class="notice-tabs">
    <view 
      class="tab-item {{currentTab === item.id ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="id"
      bindtap="handleTabChange"
      data-type="{{item.id}}"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 2. 通知列表区域 -->
  <view class="notice-list">
    
    <!-- 加载中状态 -->
    <view class="state-box" wx:if="{{loading && notices.length === 0}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 列表展示 -->
    <block wx:if="{{notices.length > 0}}">
      <view 
        class="notice-card" 
        wx:for="{{notices}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <!-- 未读红点状态 -->
        <view class="unread-dot" wx:if="{{item.unread}}"></view>

        <!-- 左侧图标区：根据类型动态展示背景色 -->
        <view class="notice-icon-wrap type-{{item.type || 'system'}}">
          <text class="notice-icon">{{item.icon || '📢'}}</text>
        </view>

        <!-- 右侧文字内容区 -->
        <view class="notice-content">
          <view class="notice-header">
            <text class="notice-title">{{item.title}}</text>
            <text class="notice-time">{{item.time}}</text>
          </view>
          <view class="notice-brief">
            {{item.content}}
          </view>
        </view>
      </view>

      <!-- 底部加载更多提示 -->
      <view class="no-more" wx:if="{{!hasMore && notices.length > 0}}">
        — 已经到底啦 —
      </view>
      <view class="no-more" wx:elif="{{loading}}">
        加载中...
      </view>
    </block>

    <!-- 3. 空状态展示 -->
    <view class="empty-notice" wx:if="{{!loading && notices.length === 0}}">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">暂无相关通知</text>
    </view>

  </view>
</view>