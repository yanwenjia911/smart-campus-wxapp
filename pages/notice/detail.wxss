/* pages/notice/detail.wxss */
page { background: #f0f2f5; }

.detail-container { padding: 24rpx 32rpx; }

/* 头部 */
.detail-header {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.header-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.type-badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.type-blue { background: #e8f4fd; color: #1677ff; }
.type-orange { background: #fff7e6; color: #ff9500; }
.type-gray { background: #f5f5f5; color: #666; }

.priority-badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.priority-badge.high { background: #fff1f0; color: #ff4d4f; }

.top-badge { font-size: 22rpx; color: #ff9500; font-weight: 500; }

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  display: block;
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-item { font-size: 24rpx; color: #888; }

/* 分割线 */
.divider { height: 1rpx; background: #eee; margin: 0 32rpx 16rpx; }

/* 正文 */
.detail-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 附件 */
.attachment-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }

.attachment-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.attachment-link { font-size: 26rpx; color: #1677ff; }

/* 有效期提示 */
.expire-tip {
  background: #fff9e6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #996600;
}

/* 加载状态 */
.loading-box { display: flex; flex-direction: column; align-items: center; padding: 100rpx; }
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1aad19;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; margin-top: 16rpx; }
