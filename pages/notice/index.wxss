/* 全局背景 */
.notice-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 20rpx 0;
}

/* --- 1. 顶部切换 Tab --- */
.notice-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding: 10rpx 0;
}

.tab-item.active {
  color: #07c160;
  font-weight: bold;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

/* --- 2. 通知卡片列表 --- */
.notice-list {
  padding: 0 30rpx;
}

.notice-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  position: relative;
  transition: transform 0.2s;
}

.notice-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

/* 左侧图标/类型区 */
.notice-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0fdf4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.notice-icon {
  font-size: 40rpx;
}

/* 右侧内容区 */
.notice-content {
  flex: 1;
  overflow: hidden;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  /* 标题过长省略 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  margin-right: 20rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}

.notice-brief {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2; /* 最多显示两行 */
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* --- 3. 状态标识 --- */

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

/* 不同类型的通知图标背景色 */
.type-system { background: #e6f7ff; } /* 系统通知-蓝色 */
.type-course { background: #f6ffed; } /* 课程变动-绿色 */
.type-grade  { background: #fff7e6; } /* 成绩更新-橙色 */

/* --- 4. 底部状态 --- */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-notice {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}